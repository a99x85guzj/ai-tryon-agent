# Copy this file to .env and fill in secrets locally. Never commit .env.

# Doubao Seedream / Seedance (Volcengine Ark)
ARK_API_KEY=
ARK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL_PRO=doubao-seedance-1-5-pro-251215
ARK_VIDEO_MODEL_LITE=doubao-seedance-1-0-lite-i2v-250428

# Cost controls (CNY estimates; tune the per-image estimate to your contract)
BUDGET_DAILY_LIMIT=10.00
ARK_IMAGE_COST_ESTIMATE=0.20

# Per-call CLI cost estimates (CNY; set these to your effective vendor prices)
TRYON_COST_ANALYZE_GARMENT=0
TRYON_COST_RUN_TRYON=0
TRYON_COST_GENERATE_VARIANT=0
TRYON_COST_PARTIAL_TRYON=0
TRYON_COST_GENERATE_VIDEO=0

# Alibaba Cloud Bailian try-on
ALIYUN_API_KEY=

# Alibaba Cloud OSS for turning local images into public URLs
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_PREFIX=ai-tryon/
OSS_CDN_DOMAIN=
OSS_SIGN_EXPIRATION=0

# Jimeng (optional; text-only generation only in this application)
JIMENG_ACCESS_KEY=
JIMENG_SECRET_KEY=

# Optional fallbacks used by the vendored skill
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_LLM_MODEL=
ANTHROPIC_API_KEY=
FASHN_API_KEY=
REPLICATE_API_TOKEN=
REMOVEBG_API_KEY=

# Qwen vision garment analysis (falls back to ALIYUN_API_KEY)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-vl-max

# Keep generated artifacts on D: as required by this project.
TRYON_OUTPUT_DIR=D:/projects/ai-tryon-agent/data/tryon_output

# Development frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Productization: authentication (disabled for local development)
API_AUTH_ENABLED=false
API_KEY=

# LangGraph persistence: sqlite (local) or postgres (production)
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=data/checkpoints.db
DATABASE_URL=postgresql://tryon:change-me@postgres:5432/tryon
POSTGRES_PASSWORD=change-me

# Upload completed artifacts to OSS; keep local files as a seven-day cache
OSS_PUBLISH_ENABLED=false
CACHE_RETENTION_DAYS=7
CACHE_CLEANUP_INTERVAL_HOURS=24

# Deterministic no-network runtime for deployment smoke tests only
APP_MOCK_MODE=false

# Optional LangSmith tracing
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-tryon-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
